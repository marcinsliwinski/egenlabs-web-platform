# Application
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME=eGen Labs Web Platform

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/egenlabs_web?schema=public

# Auth
# AUTH_SECRET must be at least 32 characters long.
AUTH_SECRET=change-me-change-me-change-me-change-me
AUTH_URL=http://localhost:3000
AUTH_SESSION_COOKIE_NAME=egenlabs_admin_session
AUTH_SESSION_TTL_HOURS=12
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Brevo
BREVO_API_KEY=replace-me
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=eGen Labs
BREVO_LIST_NEWSLETTER_ID=replace-me
BREVO_LIST_ENTERPRISE_ID=replace-me

# Cloudflare
CLOUDFLARE_ZONE_ID=replace-me
CLOUDFLARE_API_TOKEN=replace-me
TURNSTILE_SITE_KEY=replace-me
TURNSTILE_SECRET_KEY=replace-me

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
BUILD_STORAGE_PATH=./storage/builds
MEDIA_STORAGE_PATH=./storage/media
PUBLIC_FILES_BASE_URL=http://localhost:3000/files

# Transactional email shell
EMAIL_TRANSPORT_MODE=LOG_ONLY

# Email and download flows
DOWNLOAD_LINK_DEFAULT_MODE=private-permanent
DOWNLOAD_LINK_EXPIRATION_HOURS=72
ENABLE_DOUBLE_OPT_IN=true
ENABLE_MARKETING_CONSENT=true

# Telemetry
TELEMETRY_ENABLED=true
TELEMETRY_RETENTION_DAYS=365

# Logging and monitoring
LOG_LEVEL=info
