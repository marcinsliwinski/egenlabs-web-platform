{
  "name": "egenlabs-web-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "prisma:generate": "prisma generate",
    "smoke:health": "node scripts/smoke-health.mjs",
    "admin:create": "node scripts/create-admin-user.mjs",
    "catalog:bootstrap": "node scripts/bootstrap-product-catalog.mjs",
    "content:bootstrap": "node scripts/bootstrap-content.mjs",
    "desktop:bootstrap": "node scripts/bootstrap-desktop-news.mjs",
    "pdf:bootstrap": "node scripts/bootstrap-pdf-one-pager.mjs",
    "ops:backup:db": "bash scripts/backup-postgres.sh",
    "ops:backup:storage": "bash scripts/backup-storage.sh",
    "ops:backup:all": "bash scripts/backup-all.sh",
    "ops:restore:db": "bash scripts/restore-postgres.sh",
    "ops:restore:storage": "bash scripts/restore-storage.sh"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "16.2.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.4",
    "prisma": "^6.19.3",
    "typescript": "6.0.3"
  }
}
