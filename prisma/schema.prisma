generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  ADMIN
  EDITOR
}

model AdminUser {
  id                  String         @id @default(cuid())
  email               String         @unique
  passwordHash        String
  role                AdminRole      @default(EDITOR)
  isActive            Boolean        @default(true)
  failedLoginAttempts Int            @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  sessions            AdminSession[]
}

model AdminSession {
  id         String     @id @default(cuid())
  userId     String
  tokenHash  String     @unique
  createdAt  DateTime   @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime   @default(now())
  revokedAt  DateTime?
  user       AdminUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}


model Product {
  id        String          @id @default(cuid())
  key       String          @unique
  name      String
  slug      String          @unique
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  editions  ProductEdition[]
  builds    Build[]
}

model ProductEdition {
  id        String    @id @default(cuid())
  productId String
  key       String
  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  builds    Build[]

  @@unique([productId, key])
  @@index([productId])
}

model ReleaseChannel {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  builds    Build[]
}

model Build {
  id                  String         @id @default(cuid())
  productId           String
  editionId           String
  channelId           String
  version             String
  buildNumber         Int
  minSupportedVersion String?
  notes               String?
  isActive            Boolean        @default(false)
  publishedAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  product             Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  edition             ProductEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  channel             ReleaseChannel @relation(fields: [channelId], references: [id], onDelete: Restrict)
  assets              BuildAsset[]

  @@unique([productId, editionId, channelId, buildNumber])
  @@index([productId, editionId, channelId])
}

model BuildAsset {
  id             String   @id @default(cuid())
  buildId        String
  fileName       String
  storagePath    String
  fileSizeBytes  Int?
  checksumSha256 String?
  mimeType       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  build          Build    @relation(fields: [buildId], references: [id], onDelete: Cascade)

  @@index([buildId])
}
