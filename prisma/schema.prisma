generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  ADMIN
  EDITOR
}

enum DownloadPolicyMode {
  PUBLIC_DIRECT
  ONE_TIME
  TEMPORARY
  PRIVATE_STATIC
}

enum DownloadRequestStatus {
  PENDING
  ISSUED
  EXPIRED
  CANCELLED
  FAILED
}

enum DownloadLinkStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  REVOKED
}

enum EmailLogStatus {
  SENT
  FAILED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum ContactInquiryStatus {
  NEW
  REVIEWED
  CLOSED
}

enum EnterpriseInterestStatus {
  NEW
  QUALIFIED
  ARCHIVED
}

enum NewsFeedCategory {
  GENERAL
  RELEASE
  UPDATE
  ALERT
}

enum TelemetrySeverity {
  INFO
  WARN
  ERROR
}

enum FeedbackItemStatus {
  NEW
  REVIEWED
  PLANNED
  ARCHIVED
}

enum PdfVisibility {
  PUBLIC
  PRIVATE
}

model AdminUser {
  id                  String         @id @default(cuid())
  email               String         @unique
  passwordHash        String
  role                AdminRole      @default(EDITOR)
  isActive            Boolean        @default(true)
  failedLoginAttempts Int            @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  sessions            AdminSession[]
}

model AdminSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Product {
  id               String            @id @default(cuid())
  key              String            @unique
  name             String
  slug             String            @unique
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  editions         ProductEdition[]
  builds           Build[]
  downloadPolicies DownloadPolicy[]
  downloadRequests DownloadRequest[]
  newsFeedItems    NewsFeedItem[]
  telemetryEvents  DesktopTelemetryEvent[]
  featureRequests  FeatureRequest[]
  softwareDemandRequests SoftwareDemandRequest[]
  marketingPdf     MarketingPdf?
}

model ProductEdition {
  id               String            @id @default(cuid())
  productId        String
  key              String
  name             String
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  builds           Build[]
  downloadPolicies DownloadPolicy[]
  downloadRequests DownloadRequest[]
  newsFeedItems    NewsFeedItem[]
  telemetryEvents  DesktopTelemetryEvent[]
  featureRequests  FeatureRequest[]
  softwareDemandRequests SoftwareDemandRequest[]

  @@unique([productId, key])
  @@index([productId])
}

model ReleaseChannel {
  id               String            @id @default(cuid())
  key              String            @unique
  name             String
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  builds           Build[]
  downloadPolicies DownloadPolicy[]
  downloadRequests DownloadRequest[]
  newsFeedItems    NewsFeedItem[]
  telemetryEvents  DesktopTelemetryEvent[]
  featureRequests  FeatureRequest[]
  softwareDemandRequests SoftwareDemandRequest[]
}

model Build {
  id                  String         @id @default(cuid())
  productId           String
  editionId           String
  channelId           String
  version             String
  buildNumber         Int
  minSupportedVersion String?
  notes               String?
  isActive            Boolean        @default(false)
  publishedAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  product             Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  edition             ProductEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  channel             ReleaseChannel @relation(fields: [channelId], references: [id], onDelete: Restrict)
  assets              BuildAsset[]
  downloadLinks       DownloadLink[]
  downloadRequests    DownloadRequest[]

  @@unique([productId, editionId, channelId, buildNumber])
  @@index([productId, editionId, channelId])
}

model BuildAsset {
  id             String   @id @default(cuid())
  buildId        String
  fileName       String
  storagePath    String
  fileSizeBytes  Int?
  checksumSha256 String?
  mimeType       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  build          Build    @relation(fields: [buildId], references: [id], onDelete: Cascade)

  @@index([buildId])
}

model DownloadPolicy {
  id                       String             @id @default(cuid())
  productId                String
  editionId                String
  channelId                String
  mode                     DownloadPolicyMode
  isEnabled                Boolean            @default(true)
  linkTtlMinutes           Int?
  requireActiveBuild       Boolean            @default(true)
  requireEmailRegistration Boolean            @default(true)
  internalNotes            String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  product                  Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  edition                  ProductEdition     @relation(fields: [editionId], references: [id], onDelete: Cascade)
  channel                  ReleaseChannel     @relation(fields: [channelId], references: [id], onDelete: Restrict)
  links                    DownloadLink[]
  requests                 DownloadRequest[]

  @@unique([productId, editionId, channelId])
  @@index([productId, editionId, channelId])
}

model DownloadLink {
  id           String             @id @default(cuid())
  policyId     String
  buildId      String
  requestId    String?
  mode         DownloadPolicyMode
  status       DownloadLinkStatus @default(ACTIVE)
  tokenHash    String?            @unique
  publicSlug   String?            @unique
  expiresAt    DateTime?
  consumedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  policy       DownloadPolicy     @relation(fields: [policyId], references: [id], onDelete: Cascade)
  build        Build              @relation(fields: [buildId], references: [id], onDelete: Cascade)
  request      DownloadRequest?   @relation(fields: [requestId], references: [id], onDelete: SetNull)
  emailLogs    EmailLog[]

  @@index([policyId])
  @@index([buildId])
  @@index([requestId])
  @@index([status])
}

model Lead {
  id                     String                 @id @default(cuid())
  email                  String                 @unique
  firstSeenAt            DateTime               @default(now())
  lastSeenAt             DateTime               @default(now())
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  downloadRequests       DownloadRequest[]
  consentRecords         ConsentRecord[]
  emailLogs              EmailLog[]
  newsletterSubscription NewsletterSubscription?
  contactInquiries       ContactInquiry[]
  enterpriseInterests    EnterpriseInterest[]
}

model ConsentDefinition {
  id          String          @id
  key         String
  version     Int
  title       String
  description String?
  isRequired  Boolean         @default(false)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  records     ConsentRecord[]

  @@unique([key, version])
  @@index([key, isActive])
}

model ConsentRecord {
  id                String            @id @default(cuid())
  leadId            String
  definitionId      String
  downloadRequestId String?
  granted           Boolean
  source            String
  capturedAt        DateTime          @default(now())
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  lead              Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  definition        ConsentDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  downloadRequest   DownloadRequest?  @relation(fields: [downloadRequestId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([definitionId])
  @@index([downloadRequestId])
  @@index([capturedAt])
}

model DownloadRequest {
  id             String                @id @default(cuid())
  policyId       String?
  productId      String
  editionId      String
  channelId      String
  buildId        String?
  leadId         String?
  email          String?
  status         DownloadRequestStatus @default(PENDING)
  requestedAt    DateTime              @default(now())
  resolvedAt     DateTime?
  ipAddress      String?
  userAgent      String?
  notes          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  policy         DownloadPolicy?       @relation(fields: [policyId], references: [id], onDelete: SetNull)
  product        Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  edition        ProductEdition        @relation(fields: [editionId], references: [id], onDelete: Cascade)
  channel        ReleaseChannel        @relation(fields: [channelId], references: [id], onDelete: Restrict)
  build          Build?                @relation(fields: [buildId], references: [id], onDelete: SetNull)
  lead           Lead?                 @relation(fields: [leadId], references: [id], onDelete: SetNull)
  links          DownloadLink[]
  consentRecords ConsentRecord[]
  emailLogs      EmailLog[]

  @@index([policyId])
  @@index([productId, editionId, channelId])
  @@index([buildId])
  @@index([leadId])
  @@index([status])
}




model MarketingPdf {
  id            String        @id @default(cuid())
  productId     String        @unique
  title         String
  slug          String        @unique
  description   String?
  visibility    PdfVisibility @default(PUBLIC)
  fileName      String
  storagePath   String
  mimeType      String        @default("application/pdf")
  fileSizeBytes Int?
  isEnabled     Boolean       @default(false)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([visibility, isEnabled, publishedAt])
}

model NewsletterSubscription {
  id            String   @id @default(cuid())
  leadId        String   @unique
  source        String
  isActive      Boolean  @default(true)
  subscribedAt  DateTime @default(now())
  unsubscribedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lead          Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([isActive, subscribedAt])
}

model ContactInquiry {
  id                     String               @id @default(cuid())
  leadId                 String?
  email                  String
  name                   String
  company                String?
  topic                  String
  message                String
  marketingConsentGranted Boolean            @default(false)
  status                 ContactInquiryStatus @default(NEW)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  lead                   Lead?                @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([status, createdAt])
  @@index([email])
}

model EnterpriseInterest {
  id                     String                   @id @default(cuid())
  leadId                 String?
  email                  String
  name                   String
  company                String
  role                   String?
  teamSize               String?
  message                String
  marketingConsentGranted Boolean                @default(false)
  status                 EnterpriseInterestStatus @default(NEW)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  lead                   Lead?                    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([status, createdAt])
  @@index([email])
}

model FaqEntry {
  id          String        @id @default(cuid())
  slug        String        @unique
  question    String
  answer      String
  status      ContentStatus @default(DRAFT)
  sortOrder   Int           @default(100)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, sortOrder])
}

model BlogPost {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  excerpt     String
  content     String
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishedAt])
}

model NewsFeedItem {
  id          String           @id @default(cuid())
  productId   String
  editionId   String
  channelId   String
  category    NewsFeedCategory @default(GENERAL)
  slug        String           @unique
  title       String
  summary     String
  content     String
  minVersion  String?
  maxVersion  String?
  ctaLabel    String?
  ctaUrl      String?
  isPinned    Boolean          @default(false)
  status      ContentStatus    @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  product     Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  edition     ProductEdition   @relation(fields: [editionId], references: [id], onDelete: Cascade)
  channel     ReleaseChannel   @relation(fields: [channelId], references: [id], onDelete: Restrict)

  @@index([productId, editionId, channelId, status, publishedAt])
  @@index([category, status, publishedAt])
}

model DesktopTelemetryEvent {
  id             String            @id @default(cuid())
  productId      String
  editionId      String
  channelId      String
  installationId String?
  appVersion     String
  eventType      String
  severity       TelemetrySeverity @default(INFO)
  message        String?
  payloadJson    String?
  occurredAt     DateTime?
  receivedAt     DateTime          @default(now())
  ipAddress      String?
  userAgent      String?
  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  edition        ProductEdition    @relation(fields: [editionId], references: [id], onDelete: Cascade)
  channel        ReleaseChannel    @relation(fields: [channelId], references: [id], onDelete: Restrict)

  @@index([productId, editionId, channelId, receivedAt])
  @@index([installationId])
  @@index([eventType, receivedAt])
  @@index([severity, receivedAt])
}

model FeatureRequest {
  id             String             @id @default(cuid())
  productId      String
  editionId      String
  channelId      String
  installationId String?
  appVersion     String?
  email          String?
  title          String
  description    String
  status         FeedbackItemStatus @default(NEW)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  product        Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  edition        ProductEdition     @relation(fields: [editionId], references: [id], onDelete: Cascade)
  channel        ReleaseChannel     @relation(fields: [channelId], references: [id], onDelete: Restrict)

  @@index([productId, editionId, channelId, createdAt])
  @@index([installationId])
  @@index([status, createdAt])
  @@index([email])
}

model SoftwareDemandRequest {
  id                    String             @id @default(cuid())
  productId             String
  editionId             String
  channelId             String
  installationId        String?
  appVersion            String?
  email                 String?
  company               String?
  requestedSoftwareName String
  useCase               String
  details               String?
  status                FeedbackItemStatus @default(NEW)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  product               Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  edition               ProductEdition     @relation(fields: [editionId], references: [id], onDelete: Cascade)
  channel               ReleaseChannel     @relation(fields: [channelId], references: [id], onDelete: Restrict)

  @@index([productId, editionId, channelId, createdAt])
  @@index([installationId])
  @@index([status, createdAt])
  @@index([email])
}

model EmailTemplate {
  id               String     @id @default(cuid())
  key              String
  version          Int
  name             String
  subjectTemplate  String
  textBodyTemplate String
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  emailLogs        EmailLog[]

  @@unique([key, version])
  @@index([key, isActive])
}

model EmailLog {
  id                String         @id @default(cuid())
  templateId        String?
  templateKey       String
  templateVersion   Int?
  leadId            String?
  downloadRequestId String?
  downloadLinkId    String?
  toEmail           String
  subject           String
  textBody          String
  status            EmailLogStatus
  transportMode     String
  providerName      String?
  providerMessageId String?
  errorMessage      String?
  sentAt            DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  template          EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  lead              Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  downloadRequest   DownloadRequest? @relation(fields: [downloadRequestId], references: [id], onDelete: SetNull)
  downloadLink      DownloadLink?    @relation(fields: [downloadLinkId], references: [id], onDelete: SetNull)

  @@index([templateKey, templateVersion])
  @@index([leadId])
  @@index([downloadRequestId])
  @@index([downloadLinkId])
  @@index([toEmail])
  @@index([status])
  @@index([providerMessageId])
  @@index([createdAt])
}
