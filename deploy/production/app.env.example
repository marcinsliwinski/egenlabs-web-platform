NODE_ENV=production
DATABASE_URL=postgresql://egenlabs_production:replace-with-a-strong-random-secret@postgres:5432/egenlabs_production?schema=public
AUTH_SECRET=replace-with-at-least-32-random-characters
APP_URL=https://egenlabs.eu
APP_NAME=eGen Labs Web Platform

EMAIL_TRANSPORT_MODE=BREVO
BREVO_API_KEY=replace-with-production-brevo-api-key
BREVO_SENDER_EMAIL=kontakt@egenlabs.eu
BREVO_SENDER_NAME=eGen Labs Web Platform

TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=replace-with-production-site-key
TURNSTILE_SECRET_KEY=replace-with-production-secret-key

STORAGE_ROOT=/app/storage
