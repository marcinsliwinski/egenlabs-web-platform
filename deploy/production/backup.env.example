# eGen Labs production automated backup configuration.
# Install as /etc/egenlabs-production/backup.env with root:root 0600.
# Do not commit real values, credentials, private keys, or rclone config content.

APP_DIR=/opt/egenlabs-production/app
COMPOSE_PROJECT=egenlabs-production
COMPOSE_FILE=compose.production.yaml
COMPOSE_ENV_FILE=/etc/egenlabs-production/compose.env
STORAGE_ROOT=/var/lib/egenlabs-production/storage
BACKUP_ROOT=/var/backups/egenlabs-production/automated
RESTORE_READINESS_ROOT=/var/backups/egenlabs-production/restore-readiness

# Public age recipient only. Do not store the private age identity on production
# unless a separately accepted restore-readiness drill explicitly requires it.
AGE_RECIPIENT=age1replacewithproductionpublicrecipient
# AGE_IDENTITY_FILE=/root/.config/egenlabs-production/age-identity.txt

# Rclone destination restricted to the automated production backup prefix.
# Example for an R2 remote named "r2":
RCLONE_DESTINATION=r2:egenlabs-production-backups/production/automated

LOCAL_RETENTION_DAYS=14
REMOTE_RETENTION_DAYS=30
REMOTE_RETENTION_ENABLED=true
FAILED_WORKDIR_KEEP=2
