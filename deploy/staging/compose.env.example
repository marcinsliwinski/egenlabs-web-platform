# Docker Compose and Caddy
APP_DOMAIN=staging.egenlabs.eu
ACME_EMAIL=replace-with-operations-email@example.com
APP_IMAGE_TAG=staging
APP_ENV_FILE=/etc/egenlabs-staging/app.env

# PostgreSQL service
POSTGRES_DB=egenlabs_staging
POSTGRES_USER=egenlabs_app
# Replace with a unique staging-only secret, for example: openssl rand -hex 32
POSTGRES_PASSWORD=change-me
