# Application
NODE_ENV=production
APP_URL=https://staging.egenlabs.eu
APP_NAME=eGen Labs Web Platform

# Database
DATABASE_URL=postgresql://egenlabs_app:replace-with-the-same-64-hex-password@postgres:5432/egenlabs_staging?schema=public

# Auth
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_URL=https://staging.egenlabs.eu
AUTH_SESSION_COOKIE_NAME=egenlabs_staging_admin_session
AUTH_SESSION_TTL_HOURS=12
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Brevo
BREVO_API_BASE_URL=https://api.brevo.com/v3
BREVO_API_KEY=replace-me
BREVO_SENDER_EMAIL=no-reply@egenlabs.eu
BREVO_SENDER_NAME=eGen Labs
BREVO_TIMEOUT_MS=10000
BREVO_LIST_NEWSLETTER_ID=replace-me
BREVO_LIST_ENTERPRISE_ID=replace-me

# Cloudflare
CLOUDFLARE_ZONE_ID=replace-me
CLOUDFLARE_API_TOKEN=replace-me
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=replace-me
TURNSTILE_SECRET_KEY=replace-me
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
TURNSTILE_TIMEOUT_MS=5000
TURNSTILE_TOKEN_MAX_AGE_SECONDS=300
TURNSTILE_CLOCK_SKEW_SECONDS=30

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/app/storage
BUILD_STORAGE_PATH=/app/storage/builds
MEDIA_STORAGE_PATH=/app/storage/media
PUBLIC_FILES_BASE_URL=https://staging.egenlabs.eu/files

# Transactional email delivery
EMAIL_TRANSPORT_MODE=LOG_ONLY

# Email and download flows
DOWNLOAD_LINK_DEFAULT_MODE=private-permanent
DOWNLOAD_LINK_EXPIRATION_HOURS=72
ENABLE_DOUBLE_OPT_IN=true
NEWSLETTER_CONFIRMATION_TTL_HOURS=24
ENABLE_MARKETING_CONSENT=true

# Telemetry
TELEMETRY_ENABLED=true
TELEMETRY_RETENTION_DAYS=365

# Logging and monitoring
LOG_LEVEL=info
